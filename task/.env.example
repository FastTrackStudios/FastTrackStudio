# Task server runtime env. Copy to `.env` (gitignored) and fill in
# the secrets. `apps/server` loads these on boot — see
# `apps/server/src/main.rs` for the canonical list.

# ── Hermes integration ─────────────────────────────────────────────
#
# The Hermes dashboard lives on starcommand at 127.0.0.1:9119 (its
# `Invalid Host header` check rejects external-facing hostnames, so
# you MUST reach it via SSH tunnel). Open the tunnel first:
#
#   ssh -fN -L 9119:127.0.0.1:9119 -L 12490:127.0.0.1:12490 root@starcommand
#
# (12490 is the newer hermes-webui, optional — keeps both reachable.)
# Verify with:
#
#   curl -s -o /dev/null -w "%{http_code}\n" http://localhost:9119/
#
# Should return 200. Tear down with `pkill -f "ssh -fN -L 9119"`.

# Required to enable the Hermes plugin. Set to the localhost address
# the SSH tunnel forwards to; the server side enforces an Invalid
# Host header check against any other origin.
HERMES_BASE_URL=http://localhost:9119

# Session token from the Hermes dashboard UI. Empty when the dashboard
# was started without `--password` (`settings.json.password_hash` is
# null) — the server then accepts any token. Set this once you turn on
# password auth.
HERMES_SESSION_TOKEN=

# Optional board slug for `?board=` filtering on dispatch + WS.
HERMES_DEFAULT_BOARD=

# Default profile / assignee for dispatched tasks. Override per-task
# by prefixing the agent_kind with `hermes-profile:<name>:`.
HERMES_DEFAULT_PROFILE=engineer

# Optional shared secret for inbound Hermes webhooks. When unset, the
# `/webhooks/hermes/event` route returns 401 for every request.
HERMES_WEBHOOK_SECRET=

# ── Server-wide ────────────────────────────────────────────────────

# Sealing key for at-rest webhook secrets + integration tokens.
# Generate with:  openssl rand -hex 32
# When unset the server falls back to a machine-stable dev key with
# a warning — fine for local dev, never for prod.
TASK_SERVER_SEALING_KEY=

# Default bind address for `task-server`. CLI smoke flow:
#
#   TASK_DATA_ROOT=~/.task TASK_SERVER_BIND=127.0.0.1:18080 task-server
#
# Production puts a reverse-proxy in front (nginx / caddy) and
# binds the server to localhost only.
TASK_SERVER_BIND=127.0.0.1:18080

# ── Client → server vox URLs ──────────────────────────────────────
#
# Two flavors because wasm bundles can't read process env at
# runtime — only at compile time.

# `task-app-web` (wasm bundle). Baked into the build via
# `option_env!("TASK_VOX_URL_WEB")`. `dx serve` exports `.env`
# during the wasm build so dropping the var in `.env` is
# enough for local dev. CI / production passes it as a
# build-time env var.
#
# Local dev: matches the canonical task-server bind above.
# Production: the public reverse-proxy URL
# (`wss://task.example.com/vox`).
TASK_VOX_URL_WEB=ws://127.0.0.1:18080/vox

# `task` CLI + `task-app-desktop` (native). Read at runtime via
# `std::env::var`. Empty = offline mode (no sync attempted).
# Set to opt into syncing.
TASK_VOX_URL=ws://127.0.0.1:18080/vox
