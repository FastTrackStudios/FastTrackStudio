# FastTrackStudio Development Environment
# ========================================
# This file configures direnv to automatically load the Nix development shell
# when you enter this directory.
#
# Prerequisites:
#   1. Install direnv: https://direnv.net/docs/installation.html
#   2. Install nix-direnv (recommended): https://github.com/nix-community/nix-direnv
#   3. Run `direnv allow` in this directory
#
# Available shells:
#   - default: Full development environment (default)
#   - minimal: Fast-loading shell with just Rust and just
#   - ci: CI-optimized shell without startup messages

# ============================================================
# nix-direnv integration (recommended for faster reloads)
# ============================================================
# nix-direnv caches the development environment, making subsequent
# shell loads near-instantaneous instead of rebuilding from scratch.

if has nix_direnv_version; then
  # Use nix-direnv if available (much faster)
  nix_direnv_version 3.0.0

  # Watch additional files that should trigger a rebuild
  watch_file flake.nix
  watch_file flake.lock
  watch_file rust-toolchain.toml 2>/dev/null || true

  # Load the flake's default devShell
  use flake
else
  # Fallback to standard direnv flake support
  use flake
fi

# ============================================================
# Optional: Rust-specific layout
# ============================================================
# Uncomment to use direnv's Rust layout which sets CARGO_HOME
# and other Rust-specific environment variables.
# Note: This may conflict with system-wide Cargo config.
#
# layout rust

# ============================================================
# Project-specific environment
# ============================================================
# Load project-specific environment variables from .env if it exists.
# This is also done in the flake's shellHook, but loading here ensures
# variables are available even if the shell hook hasn't run yet.

if [ -f .env ]; then
  dotenv .env
fi

# ============================================================
# Path additions
# ============================================================
# Add local bin directory to PATH for project-specific scripts
PATH_add bin 2>/dev/null || true
PATH_add scripts 2>/dev/null || true

# Add cargo bin to PATH (for locally installed tools)
export PATH="$HOME/.cargo/bin:$PATH"

# ============================================================
# Rust environment
# ============================================================
# Ensure rust-analyzer can find the Rust source code
# (This is typically handled by the flake, but set as fallback)
if [ -n "$RUST_SRC_PATH" ]; then
  export RUST_SRC_PATH
fi

# ============================================================
# Editor integration hints
# ============================================================
# Some editors use these environment variables for integration:
#
# VS Code:
#   Install "direnv" extension for automatic environment loading
#
# Neovim:
#   Use direnv.nvim or similar plugin
#
# Emacs:
#   Use envrc package for direnv integration

# Silence the "direnv: loaded" message if desired (uncomment)
# export DIRENV_LOG_FORMAT=""
