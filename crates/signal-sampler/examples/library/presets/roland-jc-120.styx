// Roland JC-120 — ML Sound Lab full-rig NAM captures (amp + cab baked in).
// Scenes are the maker's voicings; each chain is the single FULL .nam.
name "Roland JC-120"
vendor "ML Sound Lab"
category "Clean Combo"
default_scene 0
scenes (
    {
        name Clean
        chain ( { kind nam, path "/run/media/starcommand/Resources/Music/Audio Haven/NAM Captures/Amps/ML Sound Labs/Roland Jazz Chorus JC-120/Full Rig/ML JAZZ 120 Clean FULL.nam", role amp } )
    }
    {
        name Drive
        chain ( { kind nam, path "/run/media/starcommand/Resources/Music/Audio Haven/NAM Captures/Amps/ML Sound Labs/Roland Jazz Chorus JC-120/Full Rig/ML JAZZ 120 Drive FULL.nam", role amp } )
    }
    {
        name Overdrive
        chain ( { kind nam, path "/run/media/starcommand/Resources/Music/Audio Haven/NAM Captures/Amps/ML Sound Labs/Roland Jazz Chorus JC-120/Full Rig/ML JAZZ 120 Overdrive FULL.nam", role amp } )
    }
)
