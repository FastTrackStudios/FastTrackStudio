    {
        name Drive
        chain ( { kind nam, path "/run/media/starcommand/Resources/Music/Audio Haven/NAM Captures/Amps/ML Sound Labs/Vox AC30/Full Rig/ML VX30 1964 Drive FULL.nam", role amp } )
