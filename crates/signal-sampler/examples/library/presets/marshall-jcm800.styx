// Marshall JCM800 — ML Sound Lab full-rig NAM captures (amp + cab baked in).
// Scenes are the maker's voicings; each chain is the single FULL .nam.
name "Marshall JCM800"
vendor "ML Sound Lab"
category "Rock"
default_scene 0
scenes (
    {
        name Clean
        chain ( { kind nam, path "/run/media/starcommand/Resources/Music/Audio Haven/NAM Captures/Amps/ML Sound Labs/Marshall JCM800/Full Rig/ML MARS 800 Clean FULL.nam", role amp } )
    }
    {
        name Drive
        chain ( { kind nam, path "/run/media/starcommand/Resources/Music/Audio Haven/NAM Captures/Amps/ML Sound Labs/Marshall JCM800/Full Rig/ML MARS 800 Drive FULL.nam", role amp } )
    }
    {
        name Lead
        chain ( { kind nam, path "/run/media/starcommand/Resources/Music/Audio Haven/NAM Captures/Amps/ML Sound Labs/Marshall JCM800/Full Rig/ML MARS 800 Lead FULL.nam", role amp } )
    }
)
