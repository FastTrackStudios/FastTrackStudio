// Mesa Dual Rectifier — ML Sound Lab full-rig NAM captures (amp + cab baked in).
// Scenes are the maker's voicings; each chain is the single FULL .nam.
name "Mesa Dual Rectifier"
vendor "ML Sound Lab"
category "Hi-Gain"
default_scene 0
scenes (
    {
        name Clean
        chain ( { kind nam, path "/run/media/starcommand/Resources/Music/Audio Haven/NAM Captures/Amps/ML Sound Labs/Mesa Boogie Dual Rectifier/Full Rig/ML MEGA Rec Clean FULL.nam", role amp } )
    }
    {
        name Drive
        chain ( { kind nam, path "/run/media/starcommand/Resources/Music/Audio Haven/NAM Captures/Amps/ML Sound Labs/Mesa Boogie Dual Rectifier/Full Rig/ML MEGA Rec Drive FULL.nam", role amp } )
    }
    {
        name Lead
        chain ( { kind nam, path "/run/media/starcommand/Resources/Music/Audio Haven/NAM Captures/Amps/ML Sound Labs/Mesa Boogie Dual Rectifier/Full Rig/ML MEGA Rec Lead FULL.nam", role amp } )
    }
)
