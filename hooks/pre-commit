#!/usr/bin/env bash
# Fast checks — must pass before every commit. Heavier checks
# (clippy, nextest) run at pre-push.

set -euo pipefail

echo "[pre-commit] cargo fmt --all --check"
cargo fmt --all --check

if command -v tracey >/dev/null 2>&1; then
    echo "[pre-commit] tracey query validate"
    tracey query validate
else
    echo "[pre-commit] tracey not on PATH — skipping spec validation"
    echo "[pre-commit]   enter the nix shell to get it"
fi
