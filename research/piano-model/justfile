# City Grand physical-model research — task shortcuts.
# Run `just` (or `just --list`) to see recipes.

# Default: build then play from the first MIDI port.
default: play

# Release build of the `pm` binary.
build:
    cargo build --release

_bin := "./target/release/pm"

# Play live from a MIDI keyboard. `just play` uses port 0; `just play 3` uses port 3.
play port="0": build
    {{_bin}} play --midi-port {{port}}

# Play a specific voicing config. `just voice out/city_grand.json 3`
voice config port="0": build
    {{_bin}} play --midi-port {{port}} --config {{config}}

# List audio output + MIDI input ports.
list: build
    {{_bin}} play --list

# Render a test chord through the realtime engine to out/play_selftest.wav.
selftest: build
    {{_bin}} play --selftest

# Rebuild the playable parameter table (8 velocity layers) from the samples.
sweep: build
    {{_bin}} sweep --vels 24,46,64,82,100,115,124,127 --out out/city_grand_table.json

# A/B one note: resynth vs real sample. `just synth 57 70`
synth note vel="90": build
    {{_bin}} synth --note {{note}} --vel {{vel}}

# Print the analysis for one note. `just analyze 57 70`
analyze note vel="90": build
    {{_bin}} analyze --note {{note}} --vel {{vel}}

# Dump the default voicing config to out/city_grand.json for editing.
config: build
    {{_bin}} config
