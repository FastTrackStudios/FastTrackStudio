{
  "compilerOptions": {
    "baseUrl": ".",
    "inlineSourceMap": true,
    "inlineSources": true,
    "module": "ESNext",
    "target": "ES2020",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": false,
    "strict": true,
    "lib": ["ES2020", "DOM"],
    "skipLibCheck": true
  },
  "include": ["main.ts", "generated/**/*.ts"]
}
