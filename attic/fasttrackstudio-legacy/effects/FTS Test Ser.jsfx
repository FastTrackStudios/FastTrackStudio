desc:FTS Test Ser
// JSFX that loads P.Inst from @serialize and sends CC 1-P.Inst on bus 15.
// CC value = slider1 * 127 for all params (simplified).
// Exports P.Inst as slider2 for diagnostic readback.

slider1:0.5<0,1>Macro Value
slider2:0<0,100>P.Inst (readback)

@init
ext_noinit = 1;
ext_midi_bus = 1;
P_Inst = 0;

@serialize
file_var(0, P_Inst);
// Read per-param data (8 mod amounts + P_OrigV per param)
i = 1;
while (i <= P_Inst) (
  m = 1;
  while (m <= 8) (
    file_var(0, ModAmt[i + m * 1000]);
    m += 1;
  );
  file_var(0, P_OrigV[i]);
  i += 1;
);

@block
// Export P.Inst for diagnostic readback.
slider2 = P_Inst;
slider_automate(slider2);

midi_bus = 15;
i = 1;
while (i <= P_Inst) (
  SendAmt = min(slider1 * 127, 127);
  SendAmt = max(SendAmt, 0);
  midisend(0, $xBF, i, SendAmt);
  i += 1;
);
