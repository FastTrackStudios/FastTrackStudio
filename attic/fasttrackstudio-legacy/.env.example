# FastTrackStudio Configuration
# Copy this file to .env and customize for your setup

# FTS installation root (default: ~/Music/FastTrackStudio)
# Set this to use a separate dev instance:
FTS_HOME=/Users/codywright/Music/Dev/FastTrackStudio

# Override REAPER paths (optional — derived from FTS_HOME by default)
# REAPER_PATH=${FTS_HOME}/Reaper/
# REAPER_EXECUTABLE=${FTS_HOME}/Reaper/FTS-LIVE.app/Contents/MacOS/REAPER

# Build mode: debug or release
BUILD_MODE=debug
